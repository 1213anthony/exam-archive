# 관리(휴지통 이동) 기능을 켜려면 아래 두 값을 .env 에 채운다. 둘 다 없으면
# 자물쇠 아이콘만 보이고 "설정 필요"라고 뜬다.
#
# Google Cloud Console > 사용자 인증 정보 > OAuth 클라이언트 ID (유형: 웹 애플리케이션)
# 승인된 JavaScript 원본에 https://1213anthony.github.io 와 http://localhost:5173 추가
VITE_GOOGLE_CLIENT_ID=
# 관리 모드에 들어갈 수 있는 구글 계정(쉼표로 구분)
VITE_ALLOWED_ADMINS=
